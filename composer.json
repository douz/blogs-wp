{
  "name": "douz/wp",
  "description": "Douz - Personal Blog",
  "authors": [
    {
      "name": "Douglas Barahona",
      "email": "douglas.barahona@me.com"
    }
  ],
  "repositories": [
		{
			"type": "composer",
			"url": "https://wpackagist.org"
		}
	],
  "config": {
    "allow-plugins": {
      "composer/installers": true
    },
    "platform": {
      "php": "8.3"
    }
  },
  "require": {
    "humanmade/s3-uploads": "3.0.13",
    "wpackagist-theme/raft":"1.1.13",
		"wpackagist-plugin/stream": "4.3.0",
    "wpackagist-plugin/redis-cache": "2.8.0",
    "wpackagist-plugin/wordpress-importer": "0.9.5",
    "wpackagist-plugin/wpforms-lite":"2.0.0.2",
    "wpackagist-plugin/wp-mail-smtp":"4.9.0",
    "wpackagist-plugin/google-site-kit":"1.184.0",
    "wpackagist-plugin/syntaxhighlighter": "3.7.2"
	},
  "extra": {
		"installer-paths": {
			"themes/{$name}": [
				"type:wordpress-theme"
			],
			"plugins/{$name}": [
				"type:wordpress-plugin"
			],
			"mu-plugins/{$name}": [
				"type:wordpress-muplugin"
			]
		}
	},
  "scripts": {
		"post-autoload-dump": [
			"cp ./plugins/redis-cache/includes/object-cache.php ./object-cache.php"
		]
	}
}
